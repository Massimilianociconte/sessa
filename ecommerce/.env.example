# Runtime serverless: transaction pooler PostgreSQL (Supabase: porta 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
# Migrazioni/pg_dump: connessione diretta o Supavisor session mode, porta 5432.
# Non usare il transaction pooler 6543 per DDL e strumenti amministrativi.
MIGRATION_DATABASE_URL=""
DIRECT_URL=""
DATABASE_CONNECTION_LIMIT="1"
# Sviluppo: DATABASE_URL deve puntare a un Postgres LOCALE (es.
# postgresql://localhost:5432/sessa_dev). Fuori da NODE_ENV=production
# lib/db-guard.ts rifiuta qualunque host remoto.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
SESSION_SECRET=""
# Solo durante la rotazione (docs/SECRET_ROTATION_RUNBOOK.md): il valore
# VECCHIO. Sessioni, link firmati e dati cifrati restano validi finché il job
# orario non ha ri-cifrato tutto (Checklist lancio → "Segreti"). Poi va svuotato.
SESSION_SECRET_PREVIOUS=""
ADMIN_SETUP_TOKEN=""
MAINTENANCE_SECRET=""
ADMIN_2FA_REQUIRED="true"
# Override consapevoli, SOLO da riga di comando per una singola operazione
# (mai in questo file):
# SESSA_ALLOW_REMOTE_DB=1           script/seed verso un DB remoto
# SESSA_CONFIRM_REMOTE_MIGRATION=1  db:deploy remoto senza conferma interattiva
# SESSA_ALLOW_DIRTY_DEPLOY=1        deploy da working tree non committato
# SESSA_ALLOW_INCOMPLETE_LEGAL=1    checkout aperto senza dati aziendali (mai in produzione)

# Proxy/CDN davanti a Netlify: "cloudflare" per fidarsi di cf-connecting-ip.
# Vuoto = solo l'IP fornito da Netlify (rate limit non aggirabile via header).
TRUSTED_PROXY=""

# Passkey: dominio definitivo (es. sessa1930.com) e origini ammesse separate
# da virgola (es. https://sessa1930.com,https://www.sessa1930.com).
# Cambiare RP ID dopo il lancio invalida le passkey già registrate.
WEBAUTHN_RP_ID=""
WEBAUTHN_ORIGINS=""

# Analytics opzionale
NEXT_PUBLIC_GA_ID=""

# Pagamenti Stripe (opzionale: se assenti resta attivo il pagamento manuale)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STOCK_RESERVATION_MINUTES="35"
# La scadenza del bonifico (giorni lavorativi) e le regole del pagamento in
# sede si impostano dal gestionale: Impostazioni → Pagamenti.

# Email SMTP (opzionale: se assente le email restano in coda / log)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sessa 1930 <no-reply@sessa1930.com>"

# Feed protetti per Google Merchant Center (URL generati dal gestionale)
MERCHANT_FEED_TOKEN=""

# Solo seed del DB locale: obbligatorie, almeno 12 caratteri, nessun default.
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""

# Test di integrazione: solo database locale "sessa_test" (ricreato a ogni run).
TEST_DATABASE_URL="postgresql://localhost:5432/sessa_test"
