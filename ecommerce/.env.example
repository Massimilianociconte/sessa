# Runtime serverless: transaction pooler PostgreSQL (Supabase: porta 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
# Migrazioni/pg_dump: connessione diretta o Supavisor session mode, porta 5432.
# Non usare il transaction pooler 6543 per DDL e strumenti amministrativi.
MIGRATION_DATABASE_URL=""
DIRECT_URL=""
DATABASE_CONNECTION_LIMIT="1"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
SESSION_SECRET=""
# Solo durante la rotazione del segreto (docs/SECRET_ROTATION_RUNBOOK.md):
# il valore VECCHIO, per decifrare i dati in busta legacy enc:v1 finche la
# ri-cifratura opportunistica non li ha coperti. Vuoto nel funzionamento normale.
SESSION_SECRET_PREVIOUS=""
ADMIN_SETUP_TOKEN=""
MAINTENANCE_SECRET=""
ADMIN_2FA_REQUIRED="true"
# Sviluppo: metti a 1 SOLO se sai di puntare deliberatamente a un DB remoto.
# Assente/0 con host Supabase in NODE_ENV!=production stampa un warning forte.
# SESSA_ALLOW_PROD_DB_FROM_DEV="1"

# Analytics opzionale
NEXT_PUBLIC_GA_ID=""

# Pagamenti Stripe (opzionale: se assenti resta attivo il pagamento manuale)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STOCK_RESERVATION_MINUTES="35"
BANK_TRANSFER_RESERVATION_HOURS="48"

# Email SMTP (opzionale: se assente le email restano in coda / log)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sessa 1930 <no-reply@sessa1930.com>"

# Feed protetti per Google Merchant Center (URL generati dal gestionale)
MERCHANT_FEED_TOKEN=""

# Solo seed/demo. In produzione configurare sempre valori forti e non riusare i fallback locali.
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
