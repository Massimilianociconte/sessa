{
  "name": "sessa-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "test:flow": "npm run test:integration",
    "test": "tsx --test tests/*.test.ts tests/*/*.test.ts",
    "test:critical": "tsx --test tests/payments/*.test.ts tests/orders/*.test.ts tests/catalog/*.test.ts tests/publication/*.test.ts tests/visibility/*.test.ts tests/checkout/*.test.ts",
    "test:security": "tsx --test tests/auth-security.test.ts",
    "db:push": "prisma db push",
    "db:bootstrap": "sh prisma/run-postgres-migrations.sh --bootstrap",
    "db:deploy": "sh prisma/run-postgres-migrations.sh",
    "db:verify": "sh prisma/verify-postgres-schema.sh",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "deploy": "npm run deploy:preview",
    "deploy:preview": "node scripts/predeploy-guard.mjs && mkdir -p .git && npx --yes netlify-cli build --context deploy-preview && node scripts/check-deploy-bundle.mjs && npx --yes netlify-cli deploy --no-build --context deploy-preview",
    "deploy:prod": "node scripts/predeploy-guard.mjs && mkdir -p .git && npx --yes netlify-cli build --context production && node scripts/check-deploy-bundle.mjs && npx --yes netlify-cli deploy --prod --no-build --context production --skip-functions-cache",
    "postbuild": "node scripts/strip-standalone-env.mjs",
    "check:bundle": "node scripts/check-deploy-bundle.mjs",
    "test:integration": "sh tests/integration/reset-db.sh && NODE_ENV=test DATABASE_URL=${TEST_DATABASE_URL:-postgresql://localhost:5432/sessa_test} tsx --test --test-concurrency=1 tests/integration/*.integration.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "@prisma/client": "^6.7.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/nodemailer": "^8.0.1",
    "next": "16.3.6",
    "nodemailer": "^9.1.1",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "stripe": "^22.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@types/node": "22.7.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "prisma": "^6.7.0",
    "tailwindcss": "3.4.14",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "deepmerge-ts": "^8.0.2",
    "nanoid": "^3.3.18",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.28.7"
  }
}
